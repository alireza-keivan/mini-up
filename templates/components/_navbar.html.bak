                                {# Instagram Followers #}
                                <a href="{% url 'core:virtual_services' %}?category=instagram" class="mega-menu-item">
                                    <div class="mega-menu-item-icon pink">
                                        <i class="fab fa-instagram"></i>
                                    </div>
                                    <div class="mega-menu-item-info">
