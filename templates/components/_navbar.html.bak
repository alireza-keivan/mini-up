                                    </div>
                                    <div class="mega-menu-item-info">
                                        <div class="mega-menu-item-title">V2Ray</div>
                                        <div class="mega-menu-item-desc">پروکسی امن</div>
                                    </div>
                                </a>
                                
                            </div>
                            
                            {# Featured Offers #}
                            <div class="mega-menu-featured">
                                <div class="mega-menu-featured-title">
                                    <i class="fas fa-fire"></i>
                                    پیشنهاد ویژه
                                </div>
                                <div class="mega-menu-featured-items">
                                    <a href="#" class="mega-menu-featured-card">
                                        <span class="mega-menu-featured-card-badge">۳۰٪ تخفیف</span>
                                        <div class="mega-menu-featured-card-content">
                                            <div class="mega-menu-featured-card-title">پکیج تلگرام پرمیوم</div>
                                            <div class="mega-menu-featured-card-desc">۳ ماهه با گارانتی</div>
                                        </div>
                                    </a>
                                    <a href="#" class="mega-menu-featured-card">
                                        <span class="mega-menu-featured-card-badge new">جدید</span>
                                        <div class="mega-menu-featured-card-content">
                                            <div class="mega-menu-featured-card-title">اسپاتیفای خانوادگی</div>
                                            <div class="mega-menu-featured-card-desc">۶ نفره - ۱ ساله</div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               Menu Item: محصولات گیمینگ (Simple Dropdown)
               ───────────────────────────────────────────────────────────────────────── #}
            <div class="navbar-menu-item">
                <a href="{% url 'core:gaming_products' %}" class="navbar-menu-link">
                    <i class="fas fa-gamepad"></i>
                    <span>محصولات گیمینگ</span>
                                        <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                
                {# Simple Dropdown #}
                <div class="navbar-dropdown">
                    <div class="navbar-dropdown-menu">
                        <div class="navbar-dropdown-header">
                            <i class="fas fa-gamepad"></i>
                            دسته‌بندی محصولات
                        </div>
                        <a href="{% url 'core:gaming_products' %}?category_detail=fan" class="navbar-dropdown-item">
                            <i class="fas fa-wind"></i>
                            <span>فن گیمینگ</span>
                        </a>
                        <a href="{% url 'core:gaming_products' %}?category_detail=finger" class="navbar-dropdown-item">
                            <i class="fas fa-hand-pointer"></i>
                            <span>دستکش انگشتی</span>
                        </a>
                        <div class="navbar-dropdown-divider"></div>
                        <a href="{% url 'core:gaming_products' %}" class="navbar-dropdown-item">
                            <i class="fas fa-th-large"></i>
                            <span>مشاهده همه محصولات</span>
                        </a>
                    </div>
                </div>
            </div>
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               Menu Item: خرید محصولات (Simple Dropdown)
               ───────────────────────────────────────────────────────────────────────── #}
            <div class="navbar-menu-item">
                <a href="{% url 'core:buy_products' %}" class="navbar-menu-link">
                    <i class="fas fa-shopping-bag"></i>
                    <span>خرید محصولات</span>
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                
                <div class="navbar-dropdown">
                    <div class="navbar-dropdown-menu">
                        <div class="navbar-dropdown-header">
                            <i class="fas fa-mobile-alt"></i>
                            لوازم جانبی موبایل
                        </div>
                        <a href="{% url 'core:buy_products' %}?category=guard" class="navbar-dropdown-item">
                            <i class="fas fa-shield-alt"></i>
                            <span>گارد موبایل</span>
                        </a>
                        <a href="{% url 'core:buy_products' %}?category=glass" class="navbar-dropdown-item">
                            <i class="fas fa-mobile-alt"></i>
                            <span>گلس محافظ</span>
                        </a>
                        <div class="navbar-dropdown-divider"></div>
                        <a href="{% url 'core:buy_products' %}" class="navbar-dropdown-item">
                            <i class="fas fa-th-large"></i>
                            <span>همه محصولات</span>
                        </a>
                    </div>
                </div>
            </div>
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               Menu Item: مینی گیم (Simple Dropdown)
               ───────────────────────────────────────────────────────────────────────── #}
            <div class="navbar-menu-item">
                <a href="{% url 'core:mini_game' %}" class="navbar-menu-link">
                    <i class="fas fa-dice"></i>
                    <span>مینی گیم</span>
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                
                <div class="navbar-dropdown">
                    <div class="navbar-dropdown-menu">
                        <div class="navbar-dropdown-header">
                            <i class="fas fa-coins"></i>
                            خرید ارز بازی
                        </div>
                        <a href="{% url 'core:mini_game' %}?game=pubg" class="navbar-dropdown-item">
                            <i class="fas fa-crosshairs"></i>
                            <span>یوسی پابجی</span>
                            <span class="navbar-dropdown-item-badge">پرفروش</span>
                        </a>
                        <a href="{% url 'core:mini_game' %}?game=freefire" class="navbar-dropdown-item">
                            <i class="fas fa-fire"></i>
                            <span>جم فری فایر</span>
                        </a>
                        <a href="{% url 'core:mini_game' %}?game=clash" class="navbar-dropdown-item">
                            <i class="fas fa-gem"></i>
                            <span>جم کلش</span>
                        </a>
                        <div class="navbar-dropdown-divider"></div>
                        <a href="{% url 'core:mini_game' %}" class="navbar-dropdown-item">
                            <i class="fas fa-gamepad"></i>
                            <span>همه بازی‌ها</span>
                        </a>
                    </div>
                </div>
            </div>
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               Menu Item: درباره ما (No Dropdown)
               ───────────────────────────────────────────────────────────────────────── #}
            <div class="navbar-menu-item">
                <a href="{% url 'core:about' %}" 
                   class="navbar-menu-link {% if request.resolver_match.url_name == 'about' %}active{% endif %}">
                    <i class="fas fa-info-circle"></i>
                    <span>درباره ما</span>
                </a>
            </div>
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               Menu Item: مشاوره رایگان (CTA Button Style)
               ───────────────────────────────────────────────────────────────────────── #}
            <div class="navbar-menu-item navbar-menu-item-cta">
                <a href="{% url 'core:consulting' %}" class="navbar-menu-link cta">
                    <i class="fas fa-headset"></i>
                    <span>مشاوره رایگان</span>
                </a>
            </div>
            
        </div>
        {# End .navbar-menu #}
        
        
        {# ═══════════════════════════════════════════════════════════════════════════
           2.3 ACTION BUTTONS (Right Side)
           ═══════════════════════════════════════════════════════════════════════════ #}
        <div class="navbar-actions">
            
            {# ─────────────────────────────────────────────────────────────────────────
               Search Button (Opens Search Modal)
               ───────────────────────────────────────────────────────────────────────── #}
            <button type="button" 
                    class="navbar-action-btn" 
                    id="searchToggle"
                    data-modal-target="searchModal"
                    aria-label="جستجو"
                    title="جستجو">
                <i class="fas fa-search"></i>
            </button>
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               Cart Button (Opens Cart Sidebar)
               ───────────────────────────────────────────────────────────────────────── #}
            <button type="button" 
                    class="navbar-action-btn" 
                    id="cartToggle"
                    data-sidebar-target="cartSidebar"
                    aria-label="سبد خرید"
                    title="سبد خرید">
                <i class="fas fa-shopping-cart"></i>
                {% if cart_count and cart_count > 0 %}
                    <span class="navbar-action-badge">{{ cart_count }}</span>
                {% endif %}
            </button>
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               Notifications Button (Dropdown)
               ───────────────────────────────────────────────────────────────────────── #}
            {% if user.is_authenticated %}
            <div class="navbar-action-dropdown">
                <button type="button" 
                        class="navbar-action-btn" 
                        id="notificationToggle"
                        aria-label="اعلان‌ها"
                        title="اعلان‌ها"
                        aria-expanded="false"
                        aria-haspopup="true">
                    <i class="fas fa-bell"></i>
                    {% if unread_notifications_count and unread_notifications_count > 0 %}
                        <span class="navbar-action-badge pulse">{{ unread_notifications_count }}</span>
                    {% endif %}
                </button>
                
                {# Notifications Dropdown #}
                <div class="navbar-notification-dropdown" id="notificationDropdown">
                    <div class="navbar-notification-header">
                        <span class="navbar-notification-title">
                            <i class="fas fa-bell"></i>
                            اعلان‌ها
                        </span>
                        {% if unread_notifications_count and unread_notifications_count > 0 %}
                            <button type="button" class="navbar-notification-mark-read" data-action="mark-all-read">
                                خواندن همه
                            </button>
                        {% endif %}
                    </div>
                    
                    <div class="navbar-notification-body">
                        {% if notifications %}
                            {% for notification in notifications|slice:":5" %}
                                <a href="{{ notification.url }}" 
                                   class="navbar-notification-item {% if not notification.is_read %}unread{% endif %}"
                                   data-notification-id="{{ notification.id }}">
                                    <div class="navbar-notification-item-icon {{ notification.type }}">
                                        {% if notification.type == 'order' %}
                                            <i class="fas fa-shopping-bag"></i>
                                        {% elif notification.type == 'wallet' %}
                                            <i class="fas fa-wallet"></i>
                                        {% elif notification.type == 'promo' %}
                                            <i class="fas fa-gift"></i>
                                        {% else %}
                                            <i class="fas fa-info-circle"></i>
                                        {% endif %}
                                    </div>
                                    <div class="navbar-notification-item-content">
                                        <div class="navbar-notification-item-title">{{ notification.title }}</div>
                                        <div class="navbar-notification-item-desc">{{ notification.message|truncatewords:10 }}</div>
                                        <div class="navbar-notification-item-time">
                                            <i class="fas fa-clock"></i>
                                            {{ notification.created_at|timesince }} پیش
                                        </div>
                                    </div>
                                    {% if not notification.is_read %}
                                        <span class="navbar-notification-item-dot"></span>
                                    {% endif %}
                                </a>
                            {% endfor %}
                        {% else %}
                            <div class="navbar-notification-empty">
                                <i class="fas fa-bell-slash"></i>
                                <span>اعلان جدیدی ندارید</span>
                            </div>
                        {% endif %}
                    </div>
                    
                    {% if notifications %}
                        <div class="navbar-notification-footer">
                            <a href="{% url 'accounts:notifications' %}" class="navbar-notification-view-all">
                                مشاهده همه اعلان‌ها
                                <i class="fas fa-arrow-left"></i>
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               User Menu (Authenticated) / Auth Buttons (Guest)
               ───────────────────────────────────────────────────────────────────────── #}
            {% if user.is_authenticated %}
                {# Authenticated User Menu #}
                <div class="navbar-action-dropdown">
                    <button type="button" 
                            class="navbar-user-btn" 
                            id="userMenuToggle"
                            aria-label="منوی کاربری"
                            aria-expanded="false"
                            aria-haspopup="true">
                        <div class="navbar-user-avatar">
                            {% if user.profile.avatar %}
                                <img src="{{ user.profile.avatar.url }}" alt="{{ user.get_display_name }}">
                            {% else %}
                                <i class="fas fa-user"></i>
                            {% endif %}
                        </div>
                        <span class="navbar-user-name">{{ user.get_display_name|default:user.phone }}</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    
                    {# User Dropdown Menu #}
                    <div class="navbar-user-dropdown" id="userMenuDropdown">
                        
                        {# User Info Header #}
                        <div class="navbar-user-dropdown-header">
                            <div class="navbar-user-dropdown-avatar">
                                {% if user.profile.avatar %}
                                    <img src="{{ user.profile.avatar.url }}" alt="{{ user.get_display_name }}">
                                {% else %}
                                    <i class="fas fa-user"></i>
                                {% endif %}
                            </div>
                            <div class="navbar-user-dropdown-info">
                                <div class="navbar-user-dropdown-name">{{ user.get_display_name|default:"کاربر" }}</div>
                                <div class="navbar-user-dropdown-phone">{{ user.phone }}</div>
                            </div>
                        </div>
                        
                        {# Wallet Balance #}
                        <div class="navbar-user-dropdown-wallet">
                            <div class="navbar-user-dropdown-wallet-label">
                                <i class="fas fa-wallet"></i>
                                موجودی کیف پول
                            </div>
                            <div class="navbar-user-dropdown-wallet-amount">
                                {{ wallet_total_balance|intcomma }} تومان
                            </div>
                            <a href="{% url 'wallet:deposit' %}" class="navbar-user-dropdown-wallet-add">
                                <i class="fas fa-plus"></i>
                                افزایش موجودی
                            </a>
                        </div>
                        
                        {# Menu Items #}
                        <div class="navbar-user-dropdown-menu">
                            <a href="{% url 'accounts:dashboard' %}" class="navbar-user-dropdown-item">
                                <i class="fas fa-tachometer-alt"></i>
                                <span>داشبورد</span>
                            </a>
                            <a href="{% url 'accounts:orders' %}" class="navbar-user-dropdown-item">
                                <i class="fas fa-shopping-bag"></i>
                                <span>سفارش‌های من</span>
                                {% if pending_orders_count %}
                                    <span class="navbar-user-dropdown-item-badge">{{ pending_orders_count }}</span>
                                {% endif %}
                            </a>
                            <a href="{% url 'accounts:transactions' %}" class="navbar-user-dropdown-item">
                                <i class="fas fa-exchange-alt"></i>
                                <span>تراکنش‌ها</span>
                            </a>
                            <a href="{% url 'accounts:tickets' %}" class="navbar-user-dropdown-item">
                                <i class="fas fa-headset"></i>
                                <span>تیکت‌های پشتیبانی</span>
                                {% if open_tickets_count %}
                                    <span class="navbar-user-dropdown-item-badge">{{ open_tickets_count }}</span>
                                {% endif %}
                            </a>
                            <a href="{% url 'accounts:favorites' %}" class="navbar-user-dropdown-item">
                                <i class="fas fa-heart"></i>
                                <span>علاقه‌مندی‌ها</span>
                            </a>
                            
                            <div class="navbar-user-dropdown-divider"></div>
                            
                            <a href="{% url 'accounts:profile' %}" class="navbar-user-dropdown-item">
                                <i class="fas fa-user-edit"></i>
                                <span>ویرایش پروفایل</span>
                            </a>
                            <a href="{% url 'accounts:settings' %}" class="navbar-user-dropdown-item">
                                <i class="fas fa-cog"></i>
                                <span>تنظیمات حساب</span>
                            </a>
                            
                            {% if user.is_staff %}
                                <div class="navbar-user-dropdown-divider"></div>
                                <a href="{% url 'admin:index' %}" class="navbar-user-dropdown-item admin">
                                    <i class="fas fa-shield-alt"></i>
                                    <span>پنل مدیریت</span>
                                </a>
                            {% endif %}
                            
                            <div class="navbar-user-dropdown-divider"></div>
                            
                            <button type="button" 
                                    class="navbar-user-dropdown-item logout"
                                    data-action="logout"
                                    data-logout-url="{% url 'accounts:logout' %}">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>خروج از حساب</span>
                            </button>
                        </div>
                        {# End .navbar-user-dropdown-menu #}
                        
                    </div>
                    {# End .navbar-user-dropdown #}
                </div>
                {# End .navbar-action-dropdown (User) #}
                
            {% else %}
                {# ─────────────────────────────────────────────────────────────────────
                   Guest User: Auth Buttons
                   ───────────────────────────────────────────────────────────────────── #}
                <div class="navbar-auth-buttons">
                    <button type="button" 
                            class="navbar-auth-btn login"
                            data-modal-target="authModal"
                            data-auth-tab="login">
                        <i class="fas fa-sign-in-alt"></i>
                        <span>ورود</span>
                    </button>
                    <button type="button" 
                            class="navbar-auth-btn register"
                            data-modal-target="authModal"
                            data-auth-tab="register">
                        <i class="fas fa-user-plus"></i>
                        <span>ثبت نام</span>
                    </button>
                </div>
            {% endif %}
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               Mobile Menu Toggle Button
               ───────────────────────────────────────────────────────────────────────── #}
            <button type="button" 
                    class="navbar-mobile-toggle"
                    id="mobileMenuToggle"
                    aria-label="منوی موبایل"
                    aria-expanded="false"
                    aria-controls="mobileMenu">
                <span class="navbar-mobile-toggle-bar"></span>
                <span class="navbar-mobile-toggle-bar"></span>
                <span class="navbar-mobile-toggle-bar"></span>
            </button>
            
        </div>
        {# End .navbar-actions #}
        
    </div>
    {# End .navbar-container #}
    
</nav>
{# ═══════════════════════════════════════════════════════════════════════════════════
   END MAIN NAVBAR
   ═══════════════════════════════════════════════════════════════════════════════════ #}


