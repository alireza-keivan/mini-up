{# ═══════════════════════════════════════════════════════════════════════════════
   NAVBAR COMPONENT - Mini-up Gaming Platform
   ═══════════════════════════════════════════════════════════════════════════════
   
   Structure:
   1. Topbar (contact info strip)
   2. Main Navbar
      - Logo
      - Desktop Menu (with dropdowns & mega menu)
      - Action Buttons (search, cart, notifications, user)
      - Mobile hamburger trigger
   
   Dependencies:
   - _mobile_menu.html (triggered by hamburger)
   - _search_modal.html (triggered by search button)
   - _cart_sidebar.html (triggered by cart button)
   
   Required Context:
   - request.user (Django auth)
   - notifications (from context processor)
   - cart_count (from context processor)
   
   ═══════════════════════════════════════════════════════════════════════════════ #}

{# ─────────────────────────────────────────────────────────────────────────────────
   SECTION 1: TOP BAR
   ───────────────────────────────────────────────────────────────────────────────── #}
{% load humanize %}
   <div class="topbar">
    <div class="topbar-container">
        
        {# Right Side - Contact Info #}
        <div class="topbar-right">
            <a href="tel:02112345678" class="topbar-item">
                <i class="fas fa-phone-alt"></i>
                <span>۰۲۱-۱۲۳۴-۵۶۷۸</span>
            </a>
            
            <div class="topbar-divider"></div>
            
            <a href="mailto:info@mini-up.ir" class="topbar-item">
                <i class="fas fa-envelope"></i>
                <span>info@mini-up.ir</span>
            </a>
            
            <div class="topbar-divider"></div>
            
            <span class="topbar-item">
                <i class="fas fa-clock"></i>
                <span>پشتیبانی ۲۴/۷</span>
            </span>
        </div>
        
        {# Left Side - Social Links #}
        <div class="topbar-left">
            <div class="topbar-social">
                <a href="#" class="topbar-social-link" title="تلگرام" aria-label="کانال تلگرام">
                    <i class="fab fa-telegram-plane"></i>
                </a>
                <a href="#" class="topbar-social-link" title="اینستاگرام" aria-label="صفحه اینستاگرام">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="#" class="topbar-social-link" title="واتساپ" aria-label="واتساپ پشتیبانی">
                    <i class="fab fa-whatsapp"></i>
                </a>
            </div>
            
            <div class="topbar-divider"></div>
            
            <a href="{% url 'core:faq' %}" class="topbar-link">سوالات متداول</a>
            <a href="{% url 'core:contact' %}" class="topbar-link">تماس با ما</a>
        </div>
        
    </div>
</div>


{# ─────────────────────────────────────────────────────────────────────────────────
   SECTION 2: MAIN NAVBAR
   ───────────────────────────────────────────────────────────────────────────────── #}
<nav class="navbar has-topbar" id="mainNavbar" role="navigation" aria-label="ناوبری اصلی">
    <div class="navbar-container">
        
        {# ═══════════════════════════════════════════════════════════════════════════
           2.1 LOGO
           ═══════════════════════════════════════════════════════════════════════════ #}
        <a href="{% url 'core:home' %}" class="navbar-logo">
            <div class="navbar-logo-icon">
                <i class="fas fa-gamepad"></i>
            </div>
            <div class="navbar-logo-text">
                <span class="navbar-logo-brand">Mini<span>-up</span></span>
                <span class="navbar-logo-tagline">گیمینگ و خدمات مجازی</span>
            </div>
        </a>
        
        
        {# ═══════════════════════════════════════════════════════════════════════════
           2.2 DESKTOP MENU
           ═══════════════════════════════════════════════════════════════════════════ #}
        <div class="navbar-menu">
            
            {# ─────────────────────────────────────────────────────────────────────────
               Menu Item: خانه (No Dropdown)
               ───────────────────────────────────────────────────────────────────────── #}
            <div class="navbar-menu-item">
                <a href="{% url 'core:home' %}" 
                   class="navbar-menu-link {% if request.resolver_match.url_name == 'home' %}active{% endif %}">
                    <i class="fas fa-home"></i>
                    <span>خانه</span>
                </a>
            </div>
            
            
            {# ─────────────────────────────────────────────────────────────────────────
               Menu Item: خدمات مجازی (MEGA MENU)
